# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas (or local: mongodb://127.0.0.1:27017/zardakhsha)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zardakhsha

# Better Auth: generate with `npx @better-auth/cli secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Stitch MCP (only for Claude Code design work, not used by the app)
STITCH_API_KEY=
